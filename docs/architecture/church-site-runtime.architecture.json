  "cards": [
    { "dot": "violet", "title": "Content Manager pipeline", "items": ["Image Pipeline (image.ts): every upload is resized/re-encoded client-side to WebP — display 1920px, thumbnail 480px", "Sanitization (sanitizeHtml.ts + DOMPurify): strips unsafe markup from admin-authored rich text before it is ever rendered back to visitors", "Audit Logger (audit.ts): writes an immutable audit-logs entry for every create/update/delete/login"] },
    { "dot": "cyan", "title": "Data model", "items": ["Firestore collections: site-data/{events,reflections,gallery}/items, audit-logs (immutable), admin-sessions", "Content is bilingual (EN/VI), selected client-side via LanguageContext", "Legacy single-doc read path kept for backward compatibility with older data"] },
    { "dot": "amber", "title": "Storage Abstraction fallback chain", "items": ["Primary: Cloud Firestore sub-collection read/write", "If Firebase isn't configured: falls back to localStorage with a stubbed local auth (admin:email key)", "Cross-tab live refresh via a BroadcastChannel/localStorage version key — no server round-trip needed for same-device tabs"] },
    { "dot": "rose", "title": "Security & trust boundaries", "items": ["All writes are gated by one hardcoded admin allowlist (admin@gmail.com), enforced server-side in Firestore/Storage rules — ProtectedRoute is UX only, not the real boundary", "Firebase Storage default-denies every path outside gallery/, events/, reflections/", "Firebase ID token lives entirely client-side; there is no custom backend session"] },
    { "dot": "slate", "title": "Edge & delivery", "items": ["Vercel serves the static Vite build with an SPA rewrite (all routes → index.html)", "@vercel/analytics and @vercel/speed-insights beacons load client-side", "Google Fonts (Be Vietnam Pro, Playfair Display) are preconnected in index.html"] }
